APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Libera /docs e /docs.json fora de local/testing (staging, demo). Padrão: false
DOCS_ENABLED=false

# Tempo de vida do token Bearer (Sanctum), em minutos. Padrão: 480 (8h)
SANCTUM_EXPIRATION=480

# Origens permitidas em requisições cross-origin (CORS). Lista separada por
# vírgula; sem valor bloqueia todas as origens no browser. Nunca use "*" em produção.
CORS_ALLOWED_ORIGINS=http://localhost:3000

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=api_tattoo
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local

# Disco das imagens de artista (upload, thumbnails, data:prune). Padrão: public
ARTIST_IMAGES_DISK=public

# Fila (e-mails auth, thumbnails). Com "database", suba um worker:
#   php artisan queue:work
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Operação (produção) ---
# Scheduler: em produção, configure um cron a cada minuto executando:
#   * * * * * php artisan schedule:run
# O schedule:run só dispara o que está registrado em routes/console.php — não limpa nada sozinho.
# Tarefa agendada hoje: data:prune (diário à 00:00) — remove imagens órfãs e audit logs expirados.
# Para rodar a limpeza manualmente: php artisan data:prune  (ou --dry-run para simular)

# Readiness (público, sem auth): GET /api/v1/health
#   Verifica database, fila (jobs) e storage de imagens. Use em uptime/load balancer.
#   200 = tudo ok | 503 = alguma dependência indisponível (JSON: status, database, queue, storage)
